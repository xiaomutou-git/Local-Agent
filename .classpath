<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src/main/java"/>
	<classpathentry kind="src" path="src/test/java" output="out/test">
		<attributes>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21"/>
	<classpathentry kind="lib" path="lib/jackson-annotations-2.13.3.jar"/>
	<classpathentry kind="lib" path="lib/jackson-core-2.13.3.jar"/>
	<classpathentry kind="lib" path="lib/jackson-databind-2.13.3.jar"/>
	<classpathentry kind="lib" path="lib/slf4j-api-1.7.36.jar"/>
	<classpathentry kind="lib" path="lib/sqlite-jdbc-3.43.0.0.jar"/>
	<classpathentry kind="output" path="out/classes"/>
</classpath>
